#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };


      tm: thumb_mods {
          compatible = "zmk,behavior-hold-tap";
	  label = "THUMB_MODS";
          #binding-cells = <2>;
          flavor = "hold-preferred";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          bindings = <&kp>, <&kp>;
      };


    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp CAPS  &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp KP_NUM
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y   &kp U     &kp I      &kp O     &kp P     &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &kp C_PP        &kp LGUI &kp LCTRL &kp RALT &kp RGUI             &none &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                           &kp HOME  &kp PG_UP                           &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
        &mo 2     &kp GRAVE &none    &kp LEFT &kp RIGHT    &tm LCTRL BSPC &tm LGUI ENTER &kp END   &kp PG_DN &tm RSHFT TAB &tm RALT SPACE      &kp DOWN  &kp UP     &kp LBKT  &kp RBKT  &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp CAPS  &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                          &mo 3 &kp N6 &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                           &none &kp Y  &kp U    &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp LSHFT &kp S    &kp D    &kp F      &kp G  &kp C_PP        &kp LGUI &kp LCTRL &kp RALT  &kp RGUI           &none &kp H  &kp J    &kp K     &kp L    &kp SEMI &kp SQT
        &kp LCTRL &kp LALT  &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                          &kp N  &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &none    &kp LEFT &kp RIGHT                  &kp SPACE &mo 2  &kp END  &kp PG_DN &tm RSHFT TAB &tm RALT SPACE             &kp DOWN &kp UP    &kp LBKT &kp RBKT &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5  &tog 1                                          &mo 3 &trans &trans &trans &trans  &trans  &trans
	&trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &kp F11 &kp N1 &kp N2 &kp N3 &kp N4 &kp N5  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &kp F12 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
