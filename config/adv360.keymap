// Replica of the Voyager layout "dima emacs" (configure.zsa.io/voyager/layouts/Aq3Zx)
// Layers: 0 Main, 1 Game, 2 leftNum, 3 numbers, 4 nav, 5 symbols, 6 Brackets, 7 fkeys, 8 System, 9 Mouse
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      // Home-row mods: fast typing (key pressed <150ms after another) always taps
      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          display-name = "Home Row Mod";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <220>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp>, <&kp>;
      };

      // Home-row layer-tap: tap = key, hold = momentary layer
      hl: homerow_layer {
          compatible = "zmk,behavior-hold-tap";
          display-name = "Home Row Layer";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <220>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&mo>, <&kp>;
      };

      // Thumb mod-tap: no idle requirement, so Shift/Alt work mid-word
      ht: thumb_mods {
          compatible = "zmk,behavior-hold-tap";
          display-name = "Thumb Mod";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          bindings = <&kp>, <&kp>;
      };

      // Hold-preferred thumb mod-tap for Super: resolves to the modifier as
      // soon as another key goes down, so fast chords like Super+T land.
      tm: thumb_mods_fast {
          compatible = "zmk,behavior-hold-tap";
          display-name = "Thumb Mod (fast)";
          #binding-cells = <2>;
          flavor = "hold-preferred";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          bindings = <&kp>, <&kp>;
      };

      dollar_brace: dollar_brace {
          compatible = "zmk,behavior-macro";
          display-name = "${}";
          #binding-cells = <0>;
          bindings = <&kp DLLR>, <&kp LBRC>, <&kp RBRC>, <&kp LEFT>;
      };

      dollar_paren: dollar_paren {
          compatible = "zmk,behavior-macro";
          display-name = "$()";
          #binding-cells = <0>;
          bindings = <&kp DLLR>, <&kp LPAR>, <&kp RPAR>, <&kp LEFT>;
      };
    };

    combos {
      compatible = "zmk,combos";
      // D + F together -> switch to Mouse layer (J = back to Main, K = Game)
      combo_mouse {
          timeout-ms = <50>;
          key-positions = <31 32>;
          bindings = <&to 9>;
          layers = <0>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    base {
      display-name = "Main";
      bindings = <
        &kp CAPS       &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &tog 1               &mo 8          &kp N6         &hl 8 N7       &kp N8         &kp N9         &kp N0         &caps_word
        &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &none                &none          &kp Y          &kp U          &kp I          &kp O          &kp P          &kp DQT
        &hm LSHFT ESC  &hm LSHFT A    &hm LCTRL S    &hl 4 D        &hl 3 F        &hm LALT G     &none             &kp LCTRL      &kp LALT       &kp LGUI       &kp RCTRL         &none          &hl 9 H        &hl 5 J        &hl 6 K        &hl 7 L        &hm RGUI SEMI  &kp SQT
        &kp RET        &kp Z          &kp X          &kp C          &kp V          &kp B             &kp HOME       &kp PG_UP         &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp DEL
        &mo 7          &kp GRAVE      &kp CAPS       &kp LEFT       &kp RIGHT         &ht LCTRL BSPC &tm LGUI RET   &kp END        &kp PG_DN      &ht RSHFT TAB  &ht RALT SPACE    &kp UP         &kp DOWN       &kp LBKT       &kp RBKT       &mo 7
      >;
    };
    game {
      display-name = "Game";
      bindings = <
        &kp CAPS  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &trans          &trans    &trans    &trans    &trans    &trans    &trans    &kp PLUS
        &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &trans          &trans    &trans    &trans    &trans    &trans    &trans    &kp MINUS
        &kp ESC   &kp LSHFT &kp S     &kp D     &kp F     &kp G     &trans       &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans
        &kp LCTRL &kp LALT  &kp X     &kp C     &kp V     &trans       &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans       &kp SPACE &mo 2     &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans
      >;
    };
    leftnum {
      display-name = "leftNum";
      bindings = <
        &kp F12 &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &kp F11 &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &kp F13 &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans     &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &kp F14 &kp N6  &kp N7  &kp N8  &kp N9  &kp N0     &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
      >;
    };
    numbers {
      display-name = "numbers";
      bindings = <
        &trans        &trans        &trans        &trans        &trans        &trans        &trans              &trans        &trans        &trans        &trans        &trans        &trans        &trans
        &kp GRAVE     &kp PIPE      &kp AT        &kp QMARK     &trans        &trans        &trans              &trans        &kp COMMA     &kp N7        &kp N8        &kp N9        &trans        &trans
        &kp TILDE     &kp EQUAL     &kp FSLH      &kp STAR      &trans        &trans        &trans           &trans        &trans        &trans        &trans           &trans        &kp N0        &kp N4        &kp N5        &kp N6        &hm RGUI SEMI &trans
        &kp BSLH      &kp UNDER     &kp PRCNT     &kp CARET     &trans        &trans           &trans        &trans           &kp DOT       &kp N1        &kp N2        &kp N3        &kp COLON     &trans
        &trans        &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &trans
      >;
    };
    nav {
      display-name = "nav";
      bindings = <
        &trans       &trans       &trans       &trans       &trans       &trans       &trans             &trans       &kp C_PREV   &kp C_STOP   &kp C_NEXT   &trans       &trans       &trans
        &trans       &trans       &trans       &trans       &trans       &trans       &trans             &trans       &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp PSCRN    &trans
        &trans       &trans       &trans       &trans       &trans       &trans       &trans          &trans       &trans       &trans       &trans          &trans       &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &trans       &trans
        &trans       &trans       &trans       &trans       &trans       &trans          &trans       &trans          &kp C_PP     &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &trans       &trans
        &trans       &trans       &trans       &trans       &trans          &trans       &trans       &trans       &trans       &trans       &trans          &trans       &trans       &trans       &trans       &trans
      >;
    };
    symbols {
      display-name = "symbols";
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans    &trans
        &kp GRAVE &kp PIPE  &kp AT    &kp QMARK &kp EXCL  &kp DLLR  &trans          &trans    &trans    &trans    &trans    &trans    &trans    &trans
        &kp TILDE &kp EQUAL &kp FSLH  &kp STAR  &kp MINUS &kp HASH  &trans       &trans    &trans    &trans    &trans       &trans    &trans    &trans    &kp C_PP  &trans    &trans    &trans
        &kp BSLH  &kp UNDER &kp PRCNT &kp CARET &kp PLUS  &kp AMPS     &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans
      >;
    };
    brackets {
      display-name = "Brackets";
      bindings = <
        &trans        &trans        &trans        &trans        &trans        &trans        &trans              &trans        &trans        &trans        &trans        &trans        &trans        &trans
        &trans        &trans        &trans        &dollar_brace &dollar_paren &kp GRAVE     &trans              &trans        &trans        &trans        &trans        &trans        &trans        &trans
        &trans        &kp LT        &kp LBKT      &kp LBRC      &kp LPAR      &kp DQT       &trans           &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &trans        &trans        &trans
        &trans        &kp GT        &kp RBKT      &kp RBRC      &kp RPAR      &kp SQT          &trans        &trans           &trans        &trans        &trans        &trans        &trans        &trans
        &trans        &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &trans
      >;
    };
    fkeys {
      display-name = "fkeys";
      bindings = <
        &kp F21 &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &kp F22 &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &kp F23 &kp F11 &kp F12 &kp F13 &kp F14 &kp F15 &trans     &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &kp F24 &kp F16 &kp F17 &kp F18 &kp F19 &kp F20    &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
      >;
    };
    system {
      display-name = "System";
      bindings = <
        &rgb_ug RGB_TOG &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bootloader           &trans          &none           &trans          &none           &none           &none           &bootloader
        &bl BL_TOG      &none           &none           &none           &none           &none           &none                 &none           &none           &none           &none           &none           &none           &none
        &studio_unlock  &none           &none           &none           &bl BL_INC      &none           &none              &none           &none           &none           &none              &none           &stp STP_BAT    &none           &none           &bt BT_CLR      &none           &none
        &none           &none           &none           &none           &bl BL_DEC      &none              &none           &none              &none           &none           &none           &macro_ver      &none           &none
        &none           &none           &none           &none           &none              &none           &none           &none           &none           &none           &none              &none           &none           &none           &none           &none
      >;
    };
    mouse {
      display-name = "Mouse";
      bindings = <
        &trans           &kp LG(N1)       &kp LG(N2)       &kp LG(N3)       &kp LG(N4)       &kp LG(N5)       &trans                 &trans           &kp LG(N6)       &kp LG(N7)       &kp LG(N8)       &kp LG(N9)       &kp LG(N0)       &trans
        &trans           &trans           &trans           &kp C_AC_BACK    &kp C_AC_FORWARD &kp LG(F)        &trans                 &trans           &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &trans           &trans
        &trans           &trans           &trans           &trans           &mkp LCLK        &mkp MCLK        &trans              &trans           &trans           &trans           &trans              &trans           &trans           &to 0            &to 1            &trans           &trans           &trans
        &trans           &trans           &trans           &trans           &mkp RCLK        &kp LALT            &trans           &trans              &msc SCRL_DOWN   &msc SCRL_UP     &trans           &trans           &trans           &trans
        &trans           &trans           &trans           &trans           &trans              &trans           &trans           &trans           &trans           &trans           &trans              &trans           &trans           &trans           &trans           &trans
      >;
    };

    extra1 {
      display-name = "Extra1";
      status = "reserved";
    };
    extra2 {
      display-name = "Extra2";
      status = "reserved";
    };
  };
};

